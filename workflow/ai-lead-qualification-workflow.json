        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemini-3.5-flash-lite\",\n  \"input\": \"You are qualifying a potential automation client.\\n\\nClient name: {{ $json.name }}\\nBudget USD: {{ $json.budget }}\\nProject: {{ $json.project }}\\n\\nEvaluate this lead based on budget, project clarity, and suitability for automation services.\",\n  \"response_format\": {\n    \"type\": \"text\",\n    \"mime_type\": \"application/json\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"classification\": {\n          \"type\": \"string\",\n          \"enum\": [\"HOT\", \"WARM\", \"COLD\"]\n        },\n        \"score\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 100\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"classification\",\n        \"score\",\n        \"reason\"\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "afcf9b25-3e3a-4e1b-8d78-997c5381c8f4",
