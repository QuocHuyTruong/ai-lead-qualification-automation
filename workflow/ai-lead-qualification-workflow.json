      "credentials": {
        "httpHeaderAuth": {
          "id": "pR7MLoJQNSf38Zge",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Lấy lại dữ liệu lead từ node Normalize Lead\nconst lead = $('Normalize Lead').first().json;\n\nconst outputStep = data.steps?.find(\n  step => step.type === 'model_output'\n);\n\nconst textPart = outputStep?.content?.find(\n  part => part.type === 'text'\n);\n\nif (!textPart?.text) {\n  throw new Error('Gemini did not return text output');\n}\n\nconst result = JSON.parse(textPart.text);\n\nreturn [\n  {\n    json: {\n      name: lead.name,\n      email: lead.email,\n      budget: lead.budget,\n      project: lead.project,\n\n      classification: result.classification,\n      score: result.score,\n      reason: result.reason,\n\n      createdAt: new Date().toISOString()\n    }\n  }\n];"
      },
